#For no err, suggest that run scf,band,makewannier with same pbs or INCAR set.

# restart = default #default: Restart from the point at which the check file seedname.chk was written.

#Iteration steps to get minimized WFs.
num_iter         = 800
num_print_cycles = 20

#Output file, can open them only after running vasp.
write_hr = true
write_xyz = true

#Reciprocal space shells used by finite difference.
search_shells = 100
# shell_list =

#disentanglement parameters
dis_num_iter    = 5000    #In the disentanglement procedure, the max number of iterations used to extract the most connected subspace.
dis_conv_tol    = 1e-12
dis_conv_window = 5

#Energy window used to get disentangled bands, pay attention to Fermi energy.
exclude_bands : 1-12, 35-36  #A k-point independent list of states to excluded from the calculation of the overlap matrices.
num_bands     = 22    #num_bands >= num_wann, suggest that check it in seedname.mmn.
dis_win_min   = -15     #as smal as possible, including projected orbitals.
dis_win_max   = -0.75
dis_froz_min  = -15    #as big as possible, without other orbitals
dis_froz_max  = -0.75

#Projected orbitals.
num_wann  = 22     #number of wannier functions(norbital*2 for spinors=T), may usually be same with disentangled bands.
spinors   = true   #WF correspond to singularly occupied spinor states, for the situation using spin.
begin projections
Mo:d
S:p
end projections

guiding_centres = true
# translate_home_cell = true
# use_ws_distance = false
# num_guide_cycles = num_iter+1 #need to test

# postproc_setup = true

#write out Wannier functions.
# wannier_plot        = true
# wannier_plot_format = xcrysden
# wannier_plot_supercell = 3 3 1

#Bands plot, to be continued.
bands_plot         = true
bands_num_points   = 30
bands_plot_format  = gnuplot xmgrace    #How to plot band, may dont need to use.
begin kpoint_path
G 0        0        0 M 0.5      0        0
M 0.5      0        0 K 0.333333 0.333333 0
K 0.333333 0.333333 0 G 0        0        0
end kpoint_path

#Will cost too many time.
# fermi_enerfy         = 0.0
# fermi_surface_plot = true

begin unit_cell_cart
   3.186000000   0.0000000000000000   0.000000000
  -1.593000000   2.7591569364572215   0.000000000
   0.000000000   0.0000000000000000  30.000000000
end unit_cell_cart

begin atoms_frac
Mo            0.3333333333        0.6666666667        0.5000000000
S             0.6666666667        0.3333333333        0.5521224027
S             0.6666666667        0.3333333333        0.4478775973
end atoms_frac
